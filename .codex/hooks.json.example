{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync --directory \"${AI_MEMORY_HOME:-$CLAUDE_MEMORY_HOME}\" python \"${AI_MEMORY_HOME:-$CLAUDE_MEMORY_HOME}/hooks/codex-session-start.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync --directory \"${AI_MEMORY_HOME:-$CLAUDE_MEMORY_HOME}\" python \"${AI_MEMORY_HOME:-$CLAUDE_MEMORY_HOME}/hooks/codex-session-end.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
