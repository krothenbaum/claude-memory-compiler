{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"$CLAUDE_MEMORY_HOME\" python \"$CLAUDE_MEMORY_HOME/hooks/session-start.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"$CLAUDE_MEMORY_HOME\" python \"$CLAUDE_MEMORY_HOME/hooks/pre-compact.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"$CLAUDE_MEMORY_HOME\" python \"$CLAUDE_MEMORY_HOME/hooks/session-end.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
